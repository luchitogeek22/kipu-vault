# ============================================================
# KipuVault — Variables de entorno (ejemplo; NO subir .env)
# ============================================================

# --- Solana ---
SOLANA_RPC_URL=https://api.devnet.solana.com
KIPU_PROGRAM_ID=KipuVau1t1111111111111111111111111111111111
KIPU_IDL_PATH=target/idl/kipu_vault.json
# Clave privada Base58 del agente (NUNCA en código, logs ni frontend)
AGENT_KEYPAIR_B58=REPLACE_WITH_AGENT_KEYPAIR_BASE58

# --- Supabase (solo backend; nunca exponer service_role en frontend) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY

# --- Auth & Seguridad Backend ---
JWT_SECRET=REPLACE_WITH_MIN_32_CHAR_RANDOM_SECRET
FRONTEND_ORIGIN=http://localhost:3000

# --- Agente LLM ---
# Proveedores soportados: anthropic | google | meta
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_KEY
GOOGLE_API_KEY=
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
RISK_BLOCK_THRESHOLD=70
KIPU_DEMO_MODE=true

# --- Frontend (solo públicas NEXT_PUBLIC_*) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID=KipuVau1t1111111111111111111111111111111111

{
  "name": "kipu-vault",
  "version": "0.1.0",
  "description": "KipuVault: Solana Smart Vault with on-chain guardrails for AI payment agents",
  "private": true,
  "scripts": {
    "test": "node --no-experimental-strip-types ./node_modules/mocha/bin/mocha.js --require ts-node/register -t 1000000 tests/**/*.ts",
    "typecheck": "tsc --noEmit",
    "sync:idl": "ts-node scripts/sync_idl.ts",
    "deploy:devnet": "bash scripts/deploy_devnet.sh",
    "setup:devnet": "ts-node scripts/setup_devnet_usdc.ts",
    "bootstrap:vault": "ts-node scripts/bootstrap_vault.ts"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.1",
    "@solana/spl-token": "0.4.9",
    "@solana/web3.js": "1.98.4",
    "bs58": "6.0.0"
  },
  "devDependencies": {
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.10.2",
    "anchor-litesvm": "0.2.1",
    "chai": "4.5.0",
    "litesvm": "1.6.2",
    "mocha": "10.8.2",
    "ts-mocha": "10.0.0",
    "ts-node": "10.9.2",
    "typescript": "5.7.2"
  }
}
